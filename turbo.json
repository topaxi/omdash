{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [
        "build/**"
      ],
      "env": [
        "OMDASH_GIT_COMMIT",
        "OMDASH_GIT_COMMITTED_AT"
      ]
    },
    "omdash-frontend#build": {
      "dependsOn": [
        "omdash-gauge#build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": [
        "build"
      ]
    }
  }
}
